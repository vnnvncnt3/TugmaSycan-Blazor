@inherits LayoutComponentBase

<header class="top-bar">
  <NavLink href="" class="brand-block">
  <img src="logo.png" alt="TugmaSycan Logo" class="logo-mark" />
  <span class="brand">TugmaSycan</span>
</NavLink>

  <nav class="top-nav">
    <div class="nav-item">
      <button class="nav-trigger" type="button" @onclick="ToggleFeatures">Features
        <svg class="chevron @(showFeatures ? "chevron-rotated" : "")" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 9l6 6 6-6"/>
        </svg>
      </button>
    </div>
    <div class="nav-item">
      <button class="nav-trigger" type="button">Solutions
        <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 9l6 6 6-6"/>
        </svg>
      </button>
    </div>
    <div class="nav-item">
      <button class="nav-trigger" type="button">Resources
        <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 9l6 6 6-6"/>
        </svg>
      </button>
    </div>
  </nav>

  <div class="top-actions">
    <NavLink href="login" class="btn-ghost">Sign in</NavLink>
    <NavLink href="register" class="btn-primary btn-primary--small">Sign up</NavLink>
  </div>
</header>

@if (showFeatures)
{
  <div class="mega-host">
    <div class="mega-panel">
      <p class="mega-label">Features</p>
      <div class="mega-grid">
        <a href="#features" class="mega-item" @onclick="ToggleFeatures">
          <span class="mega-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6"/></svg></span>
          <span class="mega-text"><span class="mega-title">Skill Extraction</span><span class="mega-desc">Pull skills, education, and experience automatically.</span></span>
        </a>
        <a href="#features" class="mega-item" @onclick="ToggleFeatures">
          <span class="mega-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg></span>
          <span class="mega-text"><span class="mega-title">Custom Requirements</span><span class="mega-desc">Define what the role actually needs, then score against it.</span></span>
        </a>
        <a href="#features" class="mega-item" @onclick="ToggleFeatures">
          <span class="mega-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><rect x="7" y="12" width="3" height="6"/><rect x="12" y="8" width="3" height="10"/><rect x="17" y="5" width="3" height="13"/></svg></span>
          <span class="mega-text"><span class="mega-title">Match Breakdown</span><span class="mega-desc">See exactly what was met, partially met, or missing.</span></span>
        </a>
        <a href="#features" class="mega-item" @onclick="ToggleFeatures">
          <span class="mega-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg></span>
          <span class="mega-text"><span class="mega-title">Fair Review Mode</span><span class="mega-desc">Hide identifying details while reviewing rankings.</span></span>
        </a>
      </div>
    </div>
  </div>
}

<main>
  @Body
</main>

<footer class="footer">
  <p class="footer-brand">TugmaSycan</p>
  <p class="footer-tagline">Scan Resumes, Match Skills, and Rank Candidates Efficiently</p>
  <p class="footer-copyright">© 2026 TugmaSycan. Built for CSIT327.</p>
</footer>

@code {
  private bool showFeatures = false;
  private void ToggleFeatures() => showFeatures = !showFeatures;
}