@page "/"
@implements IDisposable

<div class="min-h-screen bg-slate-50 text-[#22303C] flex flex-col font-sans">
  <!-- Hero Section -->
  <section class="max-w-6xl mx-auto px-6 py-16 md:py-24 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
    <div class="flex flex-col items-start text-left">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-[#22303C] leading-tight">
        Screen resumes on merit,<br class="hidden sm:inline" />
        <span class="text-[#3F6C8C]">not on first impressions.</span>
      </h1>
      <p class="mt-5 text-base sm:text-lg text-[#7C8B96] leading-relaxed">
        TugmaSycan extracts skills, scores candidates against your requirements, and shows exactly why each one ranks where they do — so you spend less time skimming and more time deciding.
      </p>
      <NavLink href="register" class="mt-8 inline-flex items-center justify-center px-7 py-3.5 rounded-lg bg-[#3F6C8C] hover:bg-[#345974] text-white text-sm font-semibold shadow-sm transition-all transform active:scale-95">
        View the Prototype
      </NavLink>
    </div>
    <div class="w-full flex justify-center">
      <img class="w-full h-72 sm:h-96 object-cover rounded-2xl shadow-lg border border-slate-200/80" 
           src="https://commons.wikimedia.org/wiki/Special:FilePath/Luke-chesser-JKUTrJ4vK00-unsplash.jpg" 
           alt="Analytics dashboard on a laptop screen" />
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="max-w-6xl mx-auto px-6 py-20 w-full border-t border-slate-200/70">
    <h2 class="text-2xl sm:text-3xl font-bold text-center text-[#22303C] mb-16">Everything you need to screen fairly</h2>

    <div class="space-y-16">
      <!-- Feature Row 1 -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div class="order-2 md:order-1 flex justify-center">
          <img class="w-full max-w-md h-64 object-cover rounded-xl shadow-md border border-slate-200" 
               src="https://commons.wikimedia.org/wiki/Special:FilePath/Example%20CV%20Resume%20(Director%20Level).png" 
               alt="A resume document being scanned for skills" />
        </div>
        <div class="order-1 md:order-2 flex flex-col items-start">
          <h3 class="text-xl sm:text-2xl font-semibold text-[#22303C]">Automatic skill extraction</h3>
          <div class="w-12 h-1 bg-[#3F6C8C] rounded my-3"></div>
          <p class="text-[#7C8B96] text-sm sm:text-base leading-relaxed">
            Upload standard text-based PDF or Word resumes in bulk. A pretrained NLP/NER model identifies skills, education, certifications, and experience — no manual data entry.
          </p>
        </div>
      </div>

      <!-- Feature Row 2 (Reversed) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div class="order-2 md:order-2 flex justify-center">
          <img class="w-full max-w-md h-64 object-cover rounded-xl shadow-md border border-slate-200" 
               src="https://commons.wikimedia.org/wiki/Special:FilePath/Questionnaire-checklist-completed.png" 
               alt="A completed requirements checklist" />
        </div>
        <div class="order-1 md:order-1 flex flex-col items-start">
          <h3 class="text-xl sm:text-2xl font-semibold text-[#22303C]">Requirements that match your role</h3>
          <div class="w-12 h-1 bg-[#3F6C8C] rounded my-3"></div>
          <p class="text-[#7C8B96] text-sm sm:text-base leading-relaxed">
            Define exactly what a role needs — years of experience, certifications, language proficiency — and let that become the scoring criteria, not a generic checklist.
          </p>
        </div>
      </div>

      <!-- Feature Row 3 -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div class="order-2 md:order-1 flex justify-center">
          <img class="w-full max-w-md h-64 object-cover rounded-xl shadow-md border border-slate-200" 
               src="https://commons.wikimedia.org/wiki/Special:FilePath/Luke-chesser-JKUTrJ4vK00-unsplash.jpg" 
               alt="Data dashboard showing scoring metrics" />
        </div>
        <div class="order-1 md:order-2 flex flex-col items-start">
          <h3 class="text-xl sm:text-2xl font-semibold text-[#22303C]">See exactly why, not just a score</h3>
          <div class="w-12 h-1 bg-[#3F6C8C] rounded my-3"></div>
          <p class="text-[#7C8B96] text-sm sm:text-base leading-relaxed">
            Rule-based criteria matching produces an itemized checklist — met, partially met, or missing — so every ranking is explainable rather than a black-box percentage.
          </p>
        </div>
      </div>

      <!-- Feature Row 4 (Reversed) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div class="order-2 md:order-2 flex justify-center">
          <img class="w-full max-w-md h-64 object-cover rounded-xl shadow-md border border-slate-200" 
               src="https://commons.wikimedia.org/wiki/Special:FilePath/Questionnaire-checklist-completed.png" 
               alt="Reviewing candidate criteria without identifying details" />
        </div>
        <div class="order-1 md:order-1 flex flex-col items-start">
          <h3 class="text-xl sm:text-2xl font-semibold text-[#22303C]">Anonymized Fair Review mode</h3>
          <div class="w-12 h-1 bg-[#3F6C8C] rounded my-3"></div>
          <p class="text-[#7C8B96] text-sm sm:text-base leading-relaxed">
            Toggle off names, schools, addresses, and photos while reviewing rankings — keeping the focus on qualifications, not identity.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Process Slideshow Section -->
  <section class="bg-white py-20 px-6 border-y border-slate-200/80 w-full">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-center text-[#22303C] mb-12">From resume to ranking in four steps</h2>

      <div class="relative w-full rounded-2xl bg-slate-50 border border-slate-200 p-6 md:p-8 min-h-[460px] flex flex-col justify-between">
        
        <!-- Active Slide Container -->
        <div class="w-full flex flex-col items-center text-center px-4 transition-opacity duration-300">
          @if (currentSlide == 0)
          {
            <img class="w-full max-w-lg h-56 sm:h-64 object-cover rounded-xl mb-6 shadow" 
                 src="https://commons.wikimedia.org/wiki/Special:FilePath/Example%20CV%20Resume%20(Director%20Level).png" 
                 alt="Uploading a resume document" />
            <h4 class="text-lg font-bold text-[#22303C] mb-2">1. Upload</h4>
            <p class="text-sm sm:text-base text-[#7C8B96] max-w-md">Drop in resumes by the batch. Supports standard text-based PDF and Word documents.</p>
          }
          else if (currentSlide == 1)
          {
            <img class="w-full max-w-lg h-56 sm:h-64 object-cover rounded-xl mb-6 shadow" 
                 src="https://commons.wikimedia.org/wiki/Special:FilePath/Questionnaire-checklist-completed.png" 
                 alt="Extracting structured data from a resume" />
            <h4 class="text-lg font-bold text-[#22303C] mb-2">2. Extract</h4>
            <p class="text-sm sm:text-base text-[#7C8B96] max-w-md">Skills, education, certifications, and experience get pulled out automatically.</p>
          }
          else if (currentSlide == 2)
          {
            <img class="w-full max-w-lg h-56 sm:h-64 object-cover rounded-xl mb-6 shadow" 
                 src="https://commons.wikimedia.org/wiki/Special:FilePath/Luke-chesser-JKUTrJ4vK00-unsplash.jpg" 
                 alt="Scoring dashboard with metrics" />
            <h4 class="text-lg font-bold text-[#22303C] mb-2">3. Score</h4>
            <p class="text-sm sm:text-base text-[#7C8B96] max-w-md">Rule-based keyword and criteria matching scores each candidate against your defined requirements.</p>
          }
          else if (currentSlide == 3)
          {
            <img class="w-full max-w-lg h-56 sm:h-64 object-cover rounded-xl mb-6 shadow" 
                 src="https://commons.wikimedia.org/wiki/Special:FilePath/Luke-chesser-JKUTrJ4vK00-unsplash.jpg" 
                 alt="Ranked results dashboard" />
            <h4 class="text-lg font-bold text-[#22303C] mb-2">4. Rank</h4>
            <p class="text-sm sm:text-base text-[#7C8B96] max-w-md">Candidates are ranked with a full breakdown — ready for your review.</p>
          }
        </div>

        <!-- Carousel Indicators -->
        <div class="flex items-center justify-center gap-3 mt-8">
          @for (int i = 0; i < 4; i++)
          {
            var slideIndex = i;
            <button type="button" 
                    class="h-2.5 rounded-full transition-all duration-300 @(currentSlide == slideIndex ? "w-8 bg-[#3F6C8C]" : "w-2.5 bg-slate-300 hover:bg-slate-400")" 
                    @onclick="() => SetSlide(slideIndex)" 
                    aria-label="Go to slide @(slideIndex + 1)">
            </button>
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Tech Stack Grid Section -->
  <section class="max-w-6xl mx-auto px-6 py-20 w-full">
    <h2 class="text-2xl sm:text-3xl font-bold text-center text-[#22303C] mb-12">Under the hood</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="bg-white border border-slate-200/90 rounded-xl p-6 shadow-sm hover:shadow transition-shadow">
        <h3 class="text-lg font-semibold text-[#22303C]">Backend</h3>
        <div class="w-8 h-1 bg-[#3F6C8C] rounded my-2.5"></div>
        <p class="text-sm text-[#7C8B96] leading-relaxed">
          Django 5 handling routing, authentication, and the ORM, organized by vertical slice so each feature owns its views, templates, and assets.
        </p>
      </div>

      <div class="bg-white border border-slate-200/90 rounded-xl p-6 shadow-sm hover:shadow transition-shadow">
        <h3 class="text-lg font-semibold text-[#22303C]">Database</h3>
        <div class="w-8 h-1 bg-[#3F6C8C] rounded my-2.5"></div>
        <p class="text-sm text-[#7C8B96] leading-relaxed">
          Supabase PostgreSQL, with schema managed entirely through Django migrations — a custom user model plus per-feature profile and settings tables.
        </p>
      </div>

      <div class="bg-white border border-slate-200/90 rounded-xl p-6 shadow-sm hover:shadow transition-shadow">
        <h3 class="text-lg font-semibold text-[#22303C]">Document parsing</h3>
        <div class="w-8 h-1 bg-[#3F6C8C] rounded my-2.5"></div>
        <p class="text-sm text-[#7C8B96] leading-relaxed">
          Python libraries for text extraction from standard PDF and Word files. Complex or creative resume layouts are intentionally out of scope.
        </p>
      </div>

      <div class="bg-white border border-slate-200/90 rounded-xl p-6 shadow-sm hover:shadow transition-shadow">
        <h3 class="text-lg font-semibold text-[#22303C]">NLP extraction</h3>
        <div class="w-8 h-1 bg-[#3F6C8C] rounded my-2.5"></div>
        <p class="text-sm text-[#7C8B96] leading-relaxed">
          A pretrained NER model tags skills, education, and certifications from extracted text. No custom-trained model — accuracy varies with resume formatting.
        </p>
      </div>

      <div class="bg-white border border-slate-200/90 rounded-xl p-6 shadow-sm hover:shadow transition-shadow">
        <h3 class="text-lg font-semibold text-[#22303C]">Scoring logic</h3>
        <div class="w-8 h-1 bg-[#3F6C8C] rounded my-2.5"></div>
        <p class="text-sm text-[#7C8B96] leading-relaxed">
          Rule-based keyword and criteria matching, not semantic embedding similarity or ML prediction. Chosen deliberately to keep scope achievable in one semester.
        </p>
      </div>

      <div class="bg-white border border-slate-200/90 rounded-xl p-6 shadow-sm hover:shadow transition-shadow">
        <h3 class="text-lg font-semibold text-[#22303C]">Fairness approach</h3>
        <div class="w-8 h-1 bg-[#3F6C8C] rounded my-2.5"></div>
        <p class="text-sm text-[#7C8B96] leading-relaxed">
          Rule-based anonymization hides identifying fields during review. No ML bias audit trained on historical hiring data — a stated limitation, not an oversight.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA Band Section -->
  <section class="bg-[#22303C] text-white py-16 px-6 text-center">
    <div class="max-w-2xl mx-auto flex flex-col items-center">
      <h2 class="text-2xl sm:text-3xl font-bold">Curious how it works under the hood?</h2>
      <p class="mt-3 text-slate-300 text-sm sm:text-base leading-relaxed">
        See the stack, the extraction pipeline, and the scoring logic that power TugmaSycan.
      </p>
      <NavLink href="register" class="mt-8 inline-flex items-center justify-center px-8 py-3.5 rounded-lg bg-[#3F6C8C] hover:bg-[#4d82a7] text-white text-sm font-semibold shadow-md transition-all transform active:scale-95">
        Explore System Architecture
      </NavLink>
    </div>
  </section>
</div>

@code {
  private int currentSlide = 0;
  private const int totalSlides = 4;
  private bool isRunning = true;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      while (isRunning)
      {
        await Task.Delay(3000); // Wait 3 seconds directly on Blazor's dispatcher
        if (!isRunning) break;

        currentSlide = (currentSlide + 1) % totalSlides;
        StateHasChanged(); // Triggers UI re-render
      }
    }
  }

  private void SetSlide(int index)
  {
    currentSlide = index;
  }

  public void Dispose()
  {
    isRunning = false;
  }
}